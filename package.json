{
  "name": "dsh-mobile-ui",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "Mobile polish for DeepSeek Harness Web 0.2.2-alpha.3+: safe areas, touch sizing, a dense header, terminal keys and long-press reordering.",
  "engines": {
    "dsh": ">=0.2.2-alpha.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
