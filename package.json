{
  "name": "dsh-mobile-ui",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Mobile shell for DeepSeek Harness Web 0.2.2+: overlay drawer, safe areas, touch and keyboard fixes.",
  "engines": {
    "dsh": ">=0.2.2-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
